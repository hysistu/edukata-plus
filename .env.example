# Neon / Postgres (use the pooled URL; sslmode=require is enough — drop channel_binding)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Required
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL (required for Payload admin cookies / redirects)
# Local: http://localhost:3000
# Vercel: https://edukata-plus.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: host media on S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
