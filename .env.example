# Postgres connection string (required on Vercel — SQLite will not work there)
# Examples:
#   Local Docker:  postgres://postgres:postgres@127.0.0.1:5432/edukataplus
#   Neon / Vercel: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/edukataplus

# Required — use a long random string in production
PAYLOAD_SECRET=replace-with-a-long-random-string

# Optional: host media on S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
# Strongly recommended on Vercel (local /media is ephemeral)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
