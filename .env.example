# Database (SQLite by default — swap to Postgres later if needed)
DATABASE_URL=file:./.db

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Optional: host media on S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
# When unset, files are stored locally in /media
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
